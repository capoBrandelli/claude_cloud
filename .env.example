# TradeAI Environment Configuration
# Copy this file to .env and fill in your API keys

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon.io (https://polygon.io/)
POLYGON_API_KEY=your_polygon_api_key_here

# Binance (https://www.binance.com/en/support/faq/360002502072)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Twelve Data (https://twelvedata.com/)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# MLflow Tracking (optional)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tradeai_experiments

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tradeai.log

# Data directories
DATA_DIR=data
CACHE_DIR=data/cache
MODELS_DIR=models
RESULTS_DIR=results

# Database (optional, for caching)
DATABASE_URL=sqlite:///data/tradeai.db
